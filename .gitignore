# Publish preparation, tissue training and coverage prediction source. Keep local data on disk.
/*
!/.gitignore
!/README.md
!/environment.yml
!/tracks.example.txt
!/LICENSE
!/LICENSE.*
!/1_prepare_data.sh
!/2_extract_features.sh
!/3_train_model_tissue.sh
!/3_train_model_tissue_homologs_onenode.sh
!/4_predict_tissue.sh
!/scripts/
/scripts/*
!/scripts/extract_cov_features.py
!/scripts/train_tissues.py
!/scripts/predict_tissues.py
!/scripts/attribution_v2.py
!/scripts/training_metrics_v2.py
!/scripts/training_curves.py
!/scripts/sequence_controls.py
!/scripts/model/
/scripts/model/*
!/scripts/model/__init__.py
!/scripts/model/models2.py
!/scripts/model/blocks.py
!/scripts/model/causal_v2.py
# Local optimization and homology files.
/optuna/
/homology/
!/tests/
/tests/*
!/tests/test_training_curves.py
!/tests/test_sequence_controls.py
!/tests/test_distributed.py
!/tests/test_homology_split.py
# Defense against generated artifacts within otherwise included directories.
__pycache__/
*.py[cod]
*.ckpt
*.pt
*.npy
*.npz
*.pdf
*.csv
*.bam
*.bw
*.fa
*.gtf
*.log
*.out
*.err
.env
.env.*

# Local training experiment launchers.
/3_train_model_tissue_homologs.sh
/3_train_model_tissue_noseq.sh
/3_train_model_tissue_shuffledutr.sh
